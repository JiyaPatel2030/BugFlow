<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BugFlow</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BugFlow.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="sidebar">
                <div class="sidebar-header">
                    <i class="bi bi-bug-fill"></i> BugFlow
                </div>
                <div class="sidebar-nav">
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2"></i> Dashboard
                    </a>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Bugs" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-area="" asp-controller="Bugs" asp-action="Index">
                        <i class="bi bi-list-task"></i> All Bugs
                    </a>
                    @if (User.IsInRole("Tester") || User.IsInRole("Admin"))
                    {
                        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Bugs" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")" asp-area="" asp-controller="Bugs" asp-action="Create">
                            <i class="bi bi-plus-circle"></i> Report Bug
                        </a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" asp-area="" asp-controller="Admin" asp-action="Users">
                            <i class="bi bi-people"></i> Users
                        </a>
                    }
                </div>
            </div>
        }

        <div class="main-content">
            <div class="topbar">
                <div class="d-flex align-items-center">
                    <h1 class="page-title fs-5 m-0 text-muted">@ViewData["Title"]</h1>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <partial name="_LoginPartial" />
                </div>
            </div>
            
            <div class="content-area">
                <partial name="_Alerts" />
                @RenderBody()
            </div>
            
            <footer class="mt-auto py-4 text-center text-meta border-top" style="border-color: var(--border-subtle) !important;">
                <div class="container">
                    &copy; 2026 - BugFlow - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacy</a>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>