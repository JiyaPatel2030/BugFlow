@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 text-center py-5 px-4 shadow-sm">
                <div class="card-body">
                    <i class="bi bi-exclamation-octagon text-danger display-1 mb-4"></i>
                    
                    <h1 class="fw-bold mb-3" style="color: var(--text-main);">Oops! Something went wrong.</h1>
                    <p class="text-meta mb-4 fs-6">An unexpected error occurred while processing your request. We've been notified and are looking into it.</p>
                    
                    @if (Model.ShowRequestId)
                    {
                        <div class="p-3 rounded-3 mb-4 d-inline-block" style="background-color: var(--bg-base); border: 1px solid var(--border-subtle);">
                            <span class="text-muted small me-2">Request ID:</span>
                            <code class="text-main fw-bold">@Model.RequestId</code>
                        </div>
                    }
                    
                    <div>
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4 py-2">
                            <i class="bi bi-house-door me-2"></i> Return to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
