@model BugFlow.Web.ViewModels.BugListViewModel
@using BugFlow.Web.Models.Enums

@{
    ViewData["Title"] = "All Bugs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title d-none">All Bugs</h1>
    
    <div class="ms-auto">
        @if (User.IsInRole("Tester") || User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus me-1"></i> Report Bug
            </a>
        }
    </div>
</div>

<div class="card border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-meta"></i>
                    </span>
                    <input type="text" name="search" value="@Model.SearchQuery" class="form-control border-start-0 ps-0" placeholder="Search bugs..." />
                </div>
            </div>

            <div class="col-md-2">
                <select name="status" asp-for="SelectedStatus" asp-items="Html.GetEnumSelectList<BugStatus>()" class="form-select text-muted">
                    <option value="">All Statuses</option>
                </select>
            </div>

            <div class="col-md-2">
                <select name="priority" asp-for="SelectedPriority" asp-items="Html.GetEnumSelectList<BugPriority>()" class="form-select text-muted">
                    <option value="">All Priorities</option>
                </select>
            </div>

            <div class="col-md-3">
                <select name="assigneeId" asp-for="SelectedAssigneeId" asp-items="Model.Developers" class="form-select text-muted">
                    <option value="">All Assignees</option>
                </select>
            </div>

            <div class="col-md-1 d-flex gap-2 justify-content-end">
                <button type="submit" class="btn btn-secondary w-100" title="Apply Filters">
                    <i class="bi bi-funnel"></i>
                </button>
                <a asp-action="Index" class="btn btn-secondary" title="Clear Filters">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0">
    <div class="card-body p-0">
        @if (!Model.Bugs.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-meta display-4 mb-3 d-block"></i>
                <h4 class="text-muted fw-normal">No bugs found</h4>
                <p class="text-meta">Try adjusting your filters or report a new bug.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Title</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Assignee</th>
                            <th>Created</th>
                            <th class="pe-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bug in Model.Bugs)
                        {
                            <tr>
                                <td class="ps-4 text-meta">#@bug.Id</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@bug.Id" class="text-decoration-none fw-medium text-main">@bug.Title</a>
                                </td>
                                <td><partial name="_PriorityBadge" model="bug.Priority" /></td>
                                <td><partial name="_StatusBadge" model="bug.Status" /></td>
                                <td>
                                    @if (bug.AssignedTo != null)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar" style="width: 24px; height: 24px; font-size: 10px;">
                                                @((bug.AssignedTo.FullName + bug.AssignedTo.Email + "U").Trim().Substring(0, 1).ToUpper())
                                            </div>
                                            <span class="text-muted" style="font-size: 13px;">@(bug.AssignedTo.FullName ?? bug.AssignedTo.Email)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-meta fst-italic">Unassigned</span>
                                    }
                                </td>
                                <td class="text-meta">@bug.CreatedDate.ToString("MMM dd, yyyy")</td>
                                <td class="pe-4 text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Details" asp-route-id="@bug.Id" class="btn btn-sm btn-secondary" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@bug.Id" class="btn btn-sm btn-secondary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form asp-action="Delete" asp-route-id="@bug.Id" method="post" onsubmit="return confirm('Delete this bug?');">
                                                <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>