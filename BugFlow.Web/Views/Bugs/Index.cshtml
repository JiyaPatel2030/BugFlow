@model BugFlow.Web.ViewModels.BugListViewModel
@using BugFlow.Web.Models.Enums

@{
    ViewData["Title"] = "Bug Directory";
}

<div class="container-fluid px-4 py-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-bug me-2 text-danger"></i>
                Bug Directory
            </h2>

            <p class="text-muted mb-0">
                View, search, and manage software issue reports.
            </p>
        </div>

        @if (User.IsInRole("Tester") || User.IsInRole("Admin"))
        {
            <a asp-action="Create"
               class="btn btn-danger btn-lg shadow-sm">

                <i class="bi bi-plus-lg me-1"></i>
                Report Bug
            </a>
        }
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3 bg-light rounded-3">

            <form method="get"
                  asp-action="Index"
                  class="row g-2 align-items-center">

                <div class="col-md-4">
                    <div class="input-group">

                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>

                        <input type="text"
                               name="search"
                               value="@Model.SearchQuery"
                               class="form-control border-start-0 ps-0"
                               placeholder="Search by title or description..." />
                    </div>
                </div>

                <div class="col-md-2">
                    <select name="status"
                            asp-for="SelectedStatus"
                            asp-items="Html.GetEnumSelectList<BugStatus>()"
                            class="form-select">

                        <option value="">-- All Statuses --</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <select name="priority"
                            asp-for="SelectedPriority"
                            asp-items="Html.GetEnumSelectList<BugPriority>()"
                            class="form-select">

                        <option value="">-- All Priorities --</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="assigneeId"
                            asp-for="SelectedAssigneeId"
                            asp-items="Model.Developers"
                            class="form-select">

                        <option value="">-- All Assignees --</option>
                    </select>
                </div>

                <div class="col-md-1 d-flex gap-1">

                    <button type="submit"
                            class="btn btn-primary w-100">

                        <i class="bi bi-funnel"></i>
                        Filter
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary"
                       title="Reset Filters">

                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>

                </div>
            </form>
        </div>
    </div>

    <!-- Bugs Table -->
    <div class="card border-0 shadow-sm rounded-3">

        <div class="card-body p-0">

            @if (!Model.Bugs.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-check-circle text-success display-1"></i>

                    <h4 class="mt-3 text-muted">
                        No bugs found
                    </h4>

                    <p class="text-secondary">
                        Try adjusting your filter settings or report a new bug.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">
                            <tr>
                                <th># ID</th>
                                <th>Title</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Reported By</th>
                                <th>Assigned To</th>
                                <th>Date Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var bug in Model.Bugs)
                            {
                                <tr>

                                    <td class="fw-bold text-secondary">
                                        BUG-@bug.Id
                                    </td>

                                    <td>
                                        <a asp-action="Details"
                                           asp-route-id="@bug.Id"
                                           class="text-decoration-none fw-semibold text-dark hover-primary">

                                            @bug.Title

                                        </a>
                                    </td>

                                    <td>

                                        @switch (bug.Priority)
                                        {
                                            case BugPriority.Critical:

                                                <span class="badge bg-danger text-white">
                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                    Critical
                                                </span>

                                                break;

                                            case BugPriority.High:

                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-arrow-up-circle me-1"></i>
                                                    High
                                                </span>

                                                break;

                                            case BugPriority.Medium:

                                                <span class="badge bg-info text-dark">
                                                    <i class="bi bi-dash-circle me-1"></i>
                                                    Medium
                                                </span>

                                                break;

                                            case BugPriority.Low:

                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-arrow-down-circle me-1"></i>
                                                    Low
                                                </span>

                                                break;
                                        }

                                    </td>

                                    <td>

                                        @switch (bug.Status)
                                        {
                                            case BugStatus.New:

                                                <span class="badge bg-primary">
                                                    New
                                                </span>

                                                break;

                                            case BugStatus.Assigned:

                                                <span class="badge bg-warning text-dark">
                                                    Assigned
                                                </span>

                                                break;

                                            case BugStatus.InProgress:

                                                <span class="badge bg-secondary">
                                                    In Progress
                                                </span>

                                                break;

                                            case BugStatus.Resolved:

                                                <span class="badge bg-success">
                                                    Resolved
                                                </span>

                                                break;

                                            case BugStatus.Closed:

                                                <span class="badge bg-dark">
                                                    Closed
                                                </span>

                                                break;

                                            case BugStatus.Reopened:

                                                <span class="badge bg-danger">
                                                    Reopened
                                                </span>

                                                break;
                                        }

                                    </td>

                                    <td>
                                        <span class="text-muted">

                                            <i class="bi bi-person me-1"></i>

                                            @(bug.ReportedBy?.FullName
                                                ?? bug.ReportedBy?.Email
                                                ?? "Unknown")

                                        </span>
                                    </td>

                                    <td>

                                        @if (bug.AssignedTo != null)
                                        {
                                            <span class="badge bg-light text-dark border">

                                                <i class="bi bi-person-badge me-1"></i>

                                                @(bug.AssignedTo.FullName
                                                    ?? bug.AssignedTo.Email)

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted italic">
                                                Unassigned
                                            </span>
                                        }

                                    </td>

                                    <td class="text-muted small">
                                        @bug.CreatedDate.ToString("yyyy-MM-dd")
                                    </td>

                                    <td class="text-end">

                                        <div class="btn-group btn-group-sm">

                                            <a asp-action="Details"
                                               asp-route-id="@bug.Id"
                                               class="btn btn-outline-secondary"
                                               title="View Details">

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@bug.Id"
                                               class="btn btn-outline-primary"
                                               title="Edit / Update Status">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            @if (User.IsInRole("Admin"))
                                            {
                                                <form asp-action="Delete"
                                                      asp-route-id="@bug.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to delete this bug?');">

                                                    <button type="submit"
                                                            class="btn btn-outline-danger"
                                                            title="Delete Bug">

                                                        <i class="bi bi-trash"></i>

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>
</div>