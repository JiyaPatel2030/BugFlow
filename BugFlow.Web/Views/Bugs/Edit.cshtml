@model BugFlow.Web.ViewModels.BugEditViewModel
@using BugFlow.Web.Models.Enums
@{
    ViewData["Title"] = $"Edit Bug #{Model.Id}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="page-title d-none">Edit Bug #@Model.Id</h1>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Details
            </a>
        </div>

        <div class="card border-0">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4 small"></div>

                    <div class="row g-4">
                        @if (Model.CanEditDetails)
                        {
                            <div class="col-md-8">
                                <label asp-for="Title" class="form-label">Bug Title</label>
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Priority" class="form-label">Priority</label>
                                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<BugPriority>()" class="form-select"></select>
                                <span asp-validation-for="Priority" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                                <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="Title" />
                            <input type="hidden" asp-for="Description" />
                            <input type="hidden" asp-for="Priority" />
                            
                            <div class="col-12">
                                <div class="p-4 rounded-3" style="background-color: var(--bg-base); border: 1px solid var(--border-subtle);">
                                    <h5 class="fw-bold mb-2 text-main">@Model.Title</h5>
                                    <p class="mb-0 text-muted" style="white-space: pre-wrap;">@Model.Description</p>
                                </div>
                            </div>
                        }

                        <div class="col-12 pt-4 mt-2 border-top" style="border-color: var(--border-subtle) !important;">
                            <h2 class="section-title mb-3">Update Status</h2>
                            
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label asp-for="Status" class="form-label">Bug Status</label>
                                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<BugStatus>()" class="form-select"></select>
                                    <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                                </div>

                                @if (Model.CanAssign)
                                {
                                    <div class="col-md-6">
                                        <label asp-for="AssignedToId" class="form-label">Assignee</label>
                                        <select asp-for="AssignedToId" asp-items="Model.AvailableDevelopers" class="form-select">
                                            <option value="">-- Unassigned --</option>
                                        </select>
                                        <span asp-validation-for="AssignedToId" class="text-danger small mt-1 d-block"></span>
                                    </div>
                                }
                                else
                                {
                                    <input type="hidden" asp-for="AssignedToId" />
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-4 mt-4 border-top" style="border-color: var(--border-subtle) !important;">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
