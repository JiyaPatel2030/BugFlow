@model BugFlow.Web.ViewModels.BugEditViewModel
@using BugFlow.Web.Models.Enums
@{
    ViewData["Title"] = $"Edit Bug #{Model.Id}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-3">
                <div class="card-header bg-primary text-white p-3 rounded-top-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Bug #@Model.Id</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @if (Model.CanEditDetails)
                        {
                            <div class="mb-3">
                                <label asp-for="Title" class="form-label fw-semibold">Bug Title</label>
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Priority" class="form-label fw-semibold">Priority</label>
                                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<BugPriority>()" class="form-select"></select>
                                <span asp-validation-for="Priority" class="text-danger small"></span>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="Title" />
                            <input type="hidden" asp-for="Description" />
                            <input type="hidden" asp-for="Priority" />
                            <div class="p-3 bg-light rounded-3 mb-3">
                                <h5 class="fw-bold mb-1">@Model.Title</h5>
                                <p class="mb-0 text-muted">@Model.Description</p>
                            </div>
                        }

                        <hr class="my-4" />

                        <!-- Status Transition Section -->
                        <div class="mb-3">
                            <label asp-for="Status" class="form-label fw-semibold">Bug Status</label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<BugStatus>()" class="form-select form-select-lg border-primary">
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                            <div class="form-text">
                                Workflow: <strong>New / Open &rarr; Assigned &rarr; InProgress &rarr; Resolved &rarr; Verified / Closed (or Reopened)</strong>
                            </div>
                        </div>

                        <!-- Assignment Section (Admin Only) -->
                        @if (Model.CanAssign)
                        {
                            <div class="mb-4">
                                <label asp-for="AssignedToId" class="form-label fw-semibold">Assign to Developer</label>
                                <select asp-for="AssignedToId" asp-items="Model.AvailableDevelopers" class="form-select">
                                    <option value="">-- Unassigned --</option>
                                </select>
                                <div class="form-text">Assigning a developer automatically advances new/open bugs to Assigned.</div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="AssignedToId" />
                        }

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg px-4">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
