@model BugFlow.Web.ViewModels.BugCreateViewModel
@using BugFlow.Web.Models.Enums
@{
    ViewData["Title"] = "Report New Bug";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-3">
                <div class="card-header bg-danger text-white p-3 rounded-top-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-bug-fill me-2"></i>Report New Bug</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">Bug Title</label>
                            <input asp-for="Title" class="form-control form-control-lg" placeholder="e.g. Login button not responding on Mobile view" autofocus />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Priority" class="form-label fw-semibold">Priority Level</label>
                            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<BugPriority>()" class="form-select form-select-lg">
                            </select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                            <div class="form-text">Select Critical for app-blocking crashes, High for main feature bugs, Medium for normal issues.</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold">Detailed Description</label>
                            <textarea asp-for="Description" class="form-control" rows="6" placeholder="Provide steps to reproduce, expected vs actual behavior, and environment details..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg px-4">
                                <i class="bi bi-send me-1"></i> Submit Bug Report
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
