@model BugFlow.Web.ViewModels.BugCreateViewModel
@using BugFlow.Web.Models.Enums
@{
    ViewData["Title"] = "Report New Bug";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="page-title d-none">Report New Bug</h1>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Bugs
            </a>
        </div>
        
        <div class="card border-0">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4 small"></div>

                    <div class="row g-4">
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label">Bug Title</label>
                            <input asp-for="Title" class="form-control form-control-lg" placeholder="e.g. Login button not responding" autofocus />
                            <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Priority" class="form-label">Priority</label>
                            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<BugPriority>()" class="form-select form-select-lg"></select>
                            <span asp-validation-for="Priority" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Detailed Description</label>
                            <textarea asp-for="Description" class="form-control" rows="8" placeholder="Steps to reproduce, expected vs actual behavior..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-4 mt-4 border-top" style="border-color: var(--border-subtle) !important;">
                        <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            Submit Bug
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
