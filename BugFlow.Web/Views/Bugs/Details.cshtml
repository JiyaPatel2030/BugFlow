@model BugFlow.Web.ViewModels.BugDetailsViewModel
@using BugFlow.Web.Models.Enums
@{
    ViewData["Title"] = $"Bug #{Model.Bug.Id} - {Model.Bug.Title}";
}

<div class="container-fluid px-4 py-3">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Bugs Directory
        </a>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Bug.Id" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i> Edit Bug / Change Status
            </a>
            @if (Model.IsAdmin)
            {
                <form asp-action="Delete" asp-route-id="@Model.Bug.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this bug?');">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Bug Details Column -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="fs-4 text-muted fw-bold">BUG-@Model.Bug.Id</span>
                        @switch (Model.Bug.Priority)
                        {
                            case BugPriority.Critical:
                                <span class="badge bg-danger fs-6"><i class="bi bi-exclamation-triangle-fill me-1"></i> Critical</span>
                                break;
                            case BugPriority.High:
                                <span class="badge bg-warning text-dark fs-6"><i class="bi bi-arrow-up-circle me-1"></i> High</span>
                                break;
                            case BugPriority.Medium:
                                <span class="badge bg-info text-dark fs-6"><i class="bi bi-dash-circle me-1"></i> Medium</span>
                                break;
                            case BugPriority.Low:
                                <span class="badge bg-secondary fs-6"><i class="bi bi-arrow-down-circle me-1"></i> Low</span>
                                break;
                        }
                        <span class="badge bg-dark fs-6 ms-auto">Status: @Model.Bug.Status</span>
                    </div>

                    <h2 class="fw-bold text-dark mb-3">@Model.Bug.Title</h2>

                    <hr />

                    <h5 class="fw-semibold text-secondary mb-2">Description</h5>
                    <div class="p-3 bg-light rounded-3 text-dark mb-3 whitespace-pre-line" style="min-height: 120px; white-space: pre-wrap;">
                        @Model.Bug.Description
                    </div>

                    <div class="row text-muted small pt-2">
                        <div class="col-sm-6">
                            <i class="bi bi-calendar3 me-1"></i> Reported: <strong>@Model.Bug.CreatedDate.ToString("F")</strong>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            @if (Model.Bug.ResolvedDate != null)
                            {
                                <i class="bi bi-check2-circle text-success me-1"></i><span class="text-success">Resolved: <strong>@Model.Bug.ResolvedDate?.ToString("F")</strong></span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Comments Section -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom p-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-chat-left-text me-2 text-primary"></i>Discussion & Comments (@Model.Comments.Count)</h4>
                </div>
                <div class="card-body p-4">
                    <!-- Comment History -->
                    @if (!Model.Comments.Any())
                    {
                        <p class="text-muted italic text-center py-3">No comments yet. Start the conversation below!</p>
                    }
                    else
                    {
                        <div class="vstack gap-3 mb-4">
                            @foreach (var comment in Model.Comments)
                            {
                                <div class="p-3 rounded-3 border bg-light">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-dark">
                                            <i class="bi bi-person-circle me-1 text-secondary"></i>@(comment.User?.FullName ?? comment.User?.Email ?? "User")
                                        </span>
                                        <span class="text-muted small">@comment.CreatedDate.ToString("g")</span>
                                    </div>
                                    <p class="mb-0 text-dark" style="white-space: pre-wrap;">@comment.Text</p>
                                </div>
                            }
                        </div>
                    }

                    <!-- Post New Comment Form -->
                    <form asp-controller="Comments" asp-action="Create" method="post" class="mt-3">
                        <input type="hidden" name="bugId" value="@Model.Bug.Id" />
                        <div class="mb-2">
                            <label class="form-label fw-semibold">Add a Comment</label>
                            <textarea name="text" class="form-control" rows="3" placeholder="Share your update, resolution notes, or verification results..." required></textarea>
                        </div>
                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send-fill me-1"></i> Post Comment
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sidebar Info Column -->
        <div class="col-lg-4">
            <!-- Assignment & Reporter Card -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white fw-bold py-3">
                    <i class="bi bi-info-circle me-2 text-info"></i>Bug Metadata
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="text-muted small d-block">Reported By</label>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                <i class="bi bi-person-fill fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold">@(Model.Bug.ReportedBy?.FullName ?? "Unknown")</div>
                                <div class="text-muted small">@(Model.Bug.ReportedBy?.Email)</div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <label class="text-muted small d-block">Assigned Developer</label>
                        @if (Model.Bug.AssignedTo != null)
                        {
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                    <i class="bi bi-code-slash fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">@(Model.Bug.AssignedTo.FullName ?? "Developer")</div>
                                    <div class="text-muted small">@(Model.Bug.AssignedTo.Email)</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning py-2 px-3 mt-2 mb-0 small">
                                <i class="bi bi-exclamation-triangle me-1"></i> Not currently assigned to any developer.
                            </div>
                        }
                    </div>

                    @if (Model.CanUserAssign)
                    {
                        <div class="pt-2">
                            <a asp-action="Edit" asp-route-id="@Model.Bug.Id" class="btn btn-outline-primary btn-sm w-100">
                                <i class="bi bi-person-plus me-1"></i> Change Assignment
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
