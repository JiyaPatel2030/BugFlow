@model BugFlow.Web.ViewModels.BugDetailsViewModel
@using BugFlow.Web.Models.Enums
@{
    ViewData["Title"] = $"BUG-{Model.Bug.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Back to Bugs">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="page-title d-none">BUG-@Model.Bug.Id</h1>
    </div>
    
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Bug.Id" class="btn btn-secondary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        @if (Model.IsAdmin)
        {
            <form asp-action="Delete" asp-route-id="@Model.Bug.Id" method="post" onsubmit="return confirm('Delete this bug?');">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i>
                </button>
            </form>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 mb-4">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <span class="text-muted fw-medium fs-5 me-2">BUG-@Model.Bug.Id</span>
                    <partial name="_PriorityBadge" model="Model.Bug.Priority" />
                    <partial name="_StatusBadge" model="Model.Bug.Status" />
                </div>

                <h2 class="fw-bold mb-4" style="color: var(--text-main); font-size: 24px;">@Model.Bug.Title</h2>
                
                <div class="mt-4" style="color: var(--text-muted); white-space: pre-wrap; font-size: 15px; line-height: 1.6;">
                    @Model.Bug.Description
                </div>
            </div>
        </div>

        <div class="card border-0">
            <div class="card-header border-0 pb-0 pt-4 px-4 px-md-5">
                <h2 class="section-title">Discussion</h2>
            </div>
            <div class="card-body p-4 p-md-5 pt-2">
                @if (!Model.Comments.Any())
                {
                    <div class="text-center py-4">
                        <p class="text-meta">No comments yet.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-4 mb-5">
                        @foreach (var comment in Model.Comments)
                        {
                            <div class="d-flex gap-3">
                                <div class="avatar flex-shrink-0">
                                    @((comment.User?.FullName + comment.User?.Email + "U").Trim().Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <div class="d-flex align-items-baseline gap-2 mb-1">
                                        <span class="fw-medium text-main" style="font-size: 14px;">@(comment.User?.FullName ?? comment.User?.Email ?? "User")</span>
                                        <span class="text-meta">@comment.CreatedDate.ToString("MMM dd, HH:mm")</span>
                                    </div>
                                    <div class="p-3 rounded-3" style="background-color: var(--bg-base); font-size: 14px; color: var(--text-muted); white-space: pre-wrap;">@comment.Text</div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <form asp-controller="Comments" asp-action="Create" method="post">
                    <input type="hidden" name="bugId" value="@Model.Bug.Id" />
                    <div class="d-flex gap-3">
                        <div class="avatar flex-shrink-0 d-none d-sm-flex">
                            <i class="bi bi-person"></i>
                        </div>
                        <div class="flex-grow-1">
                            <textarea name="text" class="form-control mb-2" rows="3" placeholder="Leave a comment..." required></textarea>
                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary">Comment</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 mb-4">
            <div class="card-header border-0 pb-0 pt-4 px-4">
                <h2 class="section-title">Details</h2>
            </div>
            <div class="card-body p-4">
                <div class="d-flex flex-column gap-4">
                    <div>
                        <span class="text-meta d-block mb-1">Assignee</span>
                        @if (Model.Bug.AssignedTo != null)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar" style="width: 28px; height: 28px;">
                                    @((Model.Bug.AssignedTo.FullName + Model.Bug.AssignedTo.Email + "U").Trim().Substring(0, 1).ToUpper())
                                </div>
                                <span class="fw-medium text-main">@(Model.Bug.AssignedTo.FullName ?? Model.Bug.AssignedTo.Email)</span>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Unassigned</span>
                        }
                    </div>

                    <div>
                        <span class="text-meta d-block mb-1">Reporter</span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="avatar" style="width: 28px; height: 28px;">
                                @((Model.Bug.ReportedBy?.FullName + Model.Bug.ReportedBy?.Email + "U").Trim().Substring(0, 1).ToUpper())
                            </div>
                            <span class="fw-medium text-main">@(Model.Bug.ReportedBy?.FullName ?? Model.Bug.ReportedBy?.Email ?? "Unknown")</span>
                        </div>
                    </div>

                    <div class="pt-2 border-top" style="border-color: var(--border-subtle) !important;">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-meta">Created</span>
                            <span class="text-main" style="font-size: 13px;">@Model.Bug.CreatedDate.ToString("MMM dd, yyyy")</span>
                        </div>
                        @if (Model.Bug.ResolvedDate != null)
                        {
                            <div class="d-flex justify-content-between">
                                <span class="text-meta">Resolved</span>
                                <span class="text-main" style="font-size: 13px;">@Model.Bug.ResolvedDate?.ToString("MMM dd, yyyy")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
