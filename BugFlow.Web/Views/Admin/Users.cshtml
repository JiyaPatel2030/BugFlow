@model List<BugFlow.Web.ViewModels.UserManagementViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title d-none">User Management</h1>
</div>

<div class="card border-0">
    <div class="card-header border-0 pb-0 pt-4 px-4">
        <h2 class="section-title">All Users</h2>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">User</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar flex-shrink-0" style="width: 36px; height: 36px; font-size: 13px;">
                                        @((user.FullName + user.Email + "U").Trim().Substring(0, 1).ToUpper())
                                    </div>
                                    <span class="fw-medium text-main">@(user.FullName ?? "—")</span>
                                </div>
                            </td>
                            <td class="text-meta">@user.Email</td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    @foreach (var role in user.Roles)
                                    {
                                        var badgeColor = role == "Admin" ? "badge-priority-critical" : role == "Developer" ? "badge-status-inprogress" : "badge-status-assigned";
                                        <span class="badge @badgeColor">@role</span>
                                    }
                                    @if (!user.Roles.Any())
                                    {
                                        <span class="badge badge-status-slate">No Role</span>
                                    }
                                </div>
                            </td>
                            <td class="pe-4 text-end">
                                <a asp-controller="Admin" asp-action="ManageRoles" asp-route-userId="@user.UserId" class="btn btn-sm btn-secondary" title="Manage Roles">
                                    <i class="bi bi-shield-lock me-1"></i> Roles
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>