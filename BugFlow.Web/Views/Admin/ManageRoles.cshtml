@model BugFlow.Web.ViewModels.ManageUserRolesViewModel
@{
    ViewData["Title"] = "Manage Roles";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="page-title d-none">Manage Roles</h1>
            <a asp-action="Users" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Users
            </a>
        </div>

        <div class="card border-0">
            <div class="card-header border-0 pb-0 pt-4 px-4 text-center">
                <div class="avatar mx-auto mb-3" style="width: 64px; height: 64px; font-size: 24px;">
                    @((Model.FullName + Model.Email + "U").Trim().Substring(0, 1).ToUpper())
                </div>
                <h2 class="section-title mb-1" style="font-size: 20px;">@Model.FullName</h2>
                <p class="text-meta">@Model.Email</p>
            </div>
            <div class="card-body p-4 p-md-5 pt-3">
                <form asp-action="ManageRoles" method="post">
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="FullName" />

                    <div class="p-4 rounded-3 mb-4" style="background-color: var(--bg-base); border: 1px solid var(--border-subtle);">
                        <h5 class="fw-semibold mb-3" style="font-size: 14px; color: var(--text-main);">Assign Roles</h5>
                        
                        <div class="d-flex flex-column gap-3">
                            @for (int i = 0; i < Model.UserRoles.Count; i++)
                            {
                                <div class="form-check d-flex align-items-center gap-2 m-0">
                                    <input type="hidden" asp-for="UserRoles[i].RoleName" />
                                    <input type="checkbox" class="form-check-input mt-0" asp-for="UserRoles[i].IsSelected" style="width: 20px; height: 20px;" />
                                    <label class="form-check-label fw-medium text-main" style="cursor: pointer;">
                                        @Model.UserRoles[i].RoleName
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Users" class="btn btn-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            Save Roles
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>