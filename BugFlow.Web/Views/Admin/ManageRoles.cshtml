@model BugFlow.Web.ViewModels.ManageUserRolesViewModel
@{
    ViewData["Title"] = "Manage Roles";
}

<h2>Manage Roles for @Model.FullName</h2>
<p class="text-muted">@Model.Email</p>

<form asp-action="ManageRoles" method="post">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="FullName" />

    @for (int i = 0; i < Model.UserRoles.Count; i++)
    {
        <div class="form-check mb-2">
            <input type="hidden" asp-for="UserRoles[i].RoleName" />
            <input type="checkbox" class="form-check-input" asp-for="UserRoles[i].IsSelected" />
            <label class="form-check-label">@Model.UserRoles[i].RoleName</label>
        </div>
    }

    <button type="submit" class="btn btn-primary mt-3">Save Changes</button>
    <a asp-action="Users" class="btn btn-secondary mt-3">Cancel</a>
</form>