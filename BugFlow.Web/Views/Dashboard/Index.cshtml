@model BugFlow.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-md-2">
        <div class="card h-100 border-0">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-bug text-meta me-2"></i>
                    <span class="text-meta">Total Bugs</span>
                </div>
                <h3 class="fw-bold mb-0">@Model.TotalBugs</h3>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card h-100 border-0">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-inbox text-meta me-2"></i>
                    <span class="text-meta">Open</span>
                </div>
                <h3 class="fw-bold mb-0">@Model.OpenBugs</h3>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card h-100 border-0">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-arrow-repeat text-meta me-2"></i>
                    <span class="text-meta">In Progress</span>
                </div>
                <h3 class="fw-bold mb-0">@Model.InProgressBugs</h3>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card h-100 border-0">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-check2-circle text-meta me-2"></i>
                    <span class="text-meta">Resolved</span>
                </div>
                <h3 class="fw-bold mb-0">@Model.ResolvedBugs</h3>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card h-100 border-0">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-archive text-meta me-2"></i>
                    <span class="text-meta">Closed</span>
                </div>
                <h3 class="fw-bold mb-0">@Model.ClosedBugs</h3>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card h-100 border-0">
            <div class="card-header border-0 pb-0">
                <h2 class="section-title">My Assigned Bugs</h2>
            </div>
            <div class="card-body pt-2">
                @if (!Model.MyAssignedBugs.Any())
                {
                    <p class="text-meta">No bugs assigned to you.</p>
                }
                else
                {
                    <div class="list-group list-group-flush border-0">
                        @foreach (var bug in Model.MyAssignedBugs)
                        {
                            <a asp-controller="Bugs" asp-action="Details" asp-route-id="@bug.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0" style="border-color: var(--border-subtle);">
                                <span class="fw-medium">@bug.Title</span>
                                <partial name="_StatusBadge" model="bug.Status" />
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100 border-0">
            <div class="card-header border-0 pb-0">
                <h2 class="section-title">My Reported Bugs</h2>
            </div>
            <div class="card-body pt-2">
                @if (!Model.MyReportedBugs.Any())
                {
                    <p class="text-meta">You haven't reported any bugs yet.</p>
                }
                else
                {
                    <div class="list-group list-group-flush border-0">
                        @foreach (var bug in Model.MyReportedBugs)
                        {
                            <a asp-controller="Bugs" asp-action="Details" asp-route-id="@bug.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0" style="border-color: var(--border-subtle);">
                                <span class="fw-medium">@bug.Title</span>
                                <partial name="_StatusBadge" model="bug.Status" />
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card border-0">
    <div class="card-header border-0 pb-0 pt-4">
        <h2 class="section-title">Recent Activity</h2>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Title</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Reporter</th>
                        <th>Assignee</th>
                        <th class="pe-4">Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bug in Model.RecentBugs)
                    {
                        <tr>
                            <td class="ps-4">
                                <a asp-controller="Bugs" asp-action="Details" asp-route-id="@bug.Id" class="text-decoration-none fw-medium text-main">@bug.Title</a>
                            </td>
                            <td><partial name="_PriorityBadge" model="bug.Priority" /></td>
                            <td><partial name="_StatusBadge" model="bug.Status" /></td>
                            <td>
                                <span class="text-muted" style="font-size: 13px;">@(bug.ReportedBy?.FullName ?? bug.ReportedBy?.Email ?? "—")</span>
                            </td>
                            <td>
                                <span class="text-muted" style="font-size: 13px;">@(bug.AssignedTo?.FullName ?? bug.AssignedTo?.Email ?? "Unassigned")</span>
                            </td>
                            <td class="pe-4 text-meta">@bug.CreatedDate.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>