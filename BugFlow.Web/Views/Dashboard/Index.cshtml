@model BugFlow.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .stat-card {
        background: linear-gradient(145deg, #ffffff, #f8fafc);
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 1rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }
    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }
    .dashboard-card {
        border-radius: 1rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(226, 232, 240, 0.8);
        background: white;
    }
    .list-group-custom .list-group-item {
        border: none;
        border-bottom: 1px solid var(--border-subtle);
        padding: 1rem 1.25rem;
        transition: background-color 0.15s ease;
    }
    .list-group-custom .list-group-item:last-child {
        border-bottom: none;
    }
    .list-group-custom .list-group-item:hover {
        background-color: var(--bg-base);
    }
</style>

<div class="row g-4 mb-4">
    <div class="col-md-2 col-sm-6">
        <div class="stat-card h-100 p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-meta fw-semibold text-uppercase tracking-wider">Total</span>
                <div class="stat-icon" style="background: #EEF2FF; color: #4F46E5;">
                    <i class="bi bi-bug-fill"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-0 text-dark display-6">@Model.TotalBugs</h2>
        </div>
    </div>
    <div class="col-md-2 col-sm-6">
        <div class="stat-card h-100 p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-meta fw-semibold text-uppercase tracking-wider">Open</span>
                <div class="stat-icon" style="background: #FEF3C7; color: #D97706;">
                    <i class="bi bi-inbox-fill"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-0 text-dark display-6">@Model.OpenBugs</h2>
        </div>
    </div>
    <div class="col-md-2 col-sm-6">
        <div class="stat-card h-100 p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-meta fw-semibold text-uppercase tracking-wider">In Progress</span>
                <div class="stat-icon" style="background: #E0E7FF; color: #4338CA;">
                    <i class="bi bi-arrow-repeat"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-0 text-dark display-6">@Model.InProgressBugs</h2>
        </div>
    </div>
    <div class="col-md-2 col-sm-6">
        <div class="stat-card h-100 p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-meta fw-semibold text-uppercase tracking-wider">Resolved</span>
                <div class="stat-icon" style="background: #D1FAE5; color: #059669;">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-0 text-dark display-6">@Model.ResolvedBugs</h2>
        </div>
    </div>
    <div class="col-md-4 col-sm-12">
        <div class="stat-card h-100 p-3" style="background: linear-gradient(145deg, #1e293b, #0f172a); color: white;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-white-50 fw-semibold text-uppercase tracking-wider">Closed</span>
                <div class="stat-icon" style="background: rgba(255,255,255,0.1); color: #cbd5e1;">
                    <i class="bi bi-archive-fill"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-0 text-white display-6">@Model.ClosedBugs</h2>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    @if (User.IsInRole("Admin"))
    {
        <div class="col-12">
            <div class="dashboard-card border-0 p-4" style="background: linear-gradient(to right, rgba(79, 70, 229, 0.05), transparent);">
                <div class="d-flex align-items-center">
                    <div class="stat-icon me-4" style="background: #EEF2FF; color: #4F46E5; width: 64px; height: 64px; font-size: 2rem;">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">Admin Dashboard</h4>
                        <p class="text-muted mb-0">You have full access to manage all bugs and users in the system. Monitor recent activity below, or use the sidebar to manage users and view the complete bug registry.</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (User.IsInRole("Developer"))
    {
        <div class="col-md-12">
            <div class="dashboard-card h-100">
                <div class="card-header bg-transparent border-0 pb-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-code-square text-primary fs-5"></i>
                        <h2 class="section-title mb-0 fw-bold">My Assigned Tasks</h2>
                    </div>
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">Developer</span>
                </div>
                <div class="card-body p-0 mt-3">
                    @if (!Model.MyAssignedBugs.Any())
                    {
                        <div class="p-5 text-center text-meta">
                            <i class="bi bi-check2-all fs-1 d-block mb-3 text-success opacity-50"></i>
                            <h5 class="fw-semibold text-dark">You're all caught up!</h5>
                            <p class="mb-0">You currently have no bugs assigned to you.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush list-group-custom">
                            @foreach (var bug in Model.MyAssignedBugs)
                            {
                                <a asp-controller="Bugs" asp-action="Details" asp-route-id="@bug.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                                    <span class="fw-medium text-dark text-truncate pe-3 fs-5">@bug.Title</span>
                                    <div class="d-flex align-items-center gap-3">
                                        <partial name="_PriorityBadge" model="bug.Priority" />
                                        <partial name="_StatusBadge" model="bug.Status" />
                                        <i class="bi bi-chevron-right text-muted opacity-50"></i>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (User.IsInRole("Tester"))
    {
        <div class="col-md-12">
            <div class="dashboard-card h-100">
                <div class="card-header bg-transparent border-0 pb-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-journal-text text-primary fs-5"></i>
                        <h2 class="section-title mb-0 fw-bold">My Reported Bugs</h2>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">QA / Tester</span>
                </div>
                <div class="card-body p-0 mt-3">
                    @if (!Model.MyReportedBugs.Any())
                    {
                        <div class="p-5 text-center text-meta">
                            <i class="bi bi-journal-x fs-1 d-block mb-3 text-muted opacity-50"></i>
                            <h5 class="fw-semibold text-dark">No bugs reported yet</h5>
                            <p class="mb-0">When you report bugs, they will appear here so you can track their resolution.</p>
                            <a asp-controller="Bugs" asp-action="Create" class="btn btn-primary mt-3 rounded-pill px-4">Report First Bug</a>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush list-group-custom">
                            @foreach (var bug in Model.MyReportedBugs)
                            {
                                <a asp-controller="Bugs" asp-action="Details" asp-route-id="@bug.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                                    <span class="fw-medium text-dark text-truncate pe-3 fs-5">@bug.Title</span>
                                    <div class="d-flex align-items-center gap-3">
                                        <partial name="_PriorityBadge" model="bug.Priority" />
                                        <partial name="_StatusBadge" model="bug.Status" />
                                        <i class="bi bi-chevron-right text-muted opacity-50"></i>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="dashboard-card">
    <div class="card-header bg-transparent border-0 pb-0 pt-4 px-4 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-activity text-primary fs-5"></i>
            <h2 class="section-title mb-0 fw-bold">Recent System Activity</h2>
        </div>
        <a asp-controller="Bugs" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">View Full Registry</a>
    </div>
    <div class="card-body p-0 mt-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 border-bottom-0 text-uppercase text-meta tracking-wider" style="font-size: 0.75rem;">Title</th>
                        <th class="border-bottom-0 text-uppercase text-meta tracking-wider" style="font-size: 0.75rem;">Priority</th>
                        <th class="border-bottom-0 text-uppercase text-meta tracking-wider" style="font-size: 0.75rem;">Status</th>
                        <th class="border-bottom-0 text-uppercase text-meta tracking-wider" style="font-size: 0.75rem;">Reporter</th>
                        <th class="border-bottom-0 text-uppercase text-meta tracking-wider" style="font-size: 0.75rem;">Assignee</th>
                        <th class="pe-4 border-bottom-0 text-uppercase text-meta tracking-wider" style="font-size: 0.75rem;">Created</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentBugs.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center p-5 text-meta border-bottom-0">No recent activity found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var bug in Model.RecentBugs)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <a asp-controller="Bugs" asp-action="Details" asp-route-id="@bug.Id" class="text-decoration-none fw-semibold text-dark">
                                        @bug.Title
                                    </a>
                                </td>
                                <td><partial name="_PriorityBadge" model="bug.Priority" /></td>
                                <td><partial name="_StatusBadge" model="bug.Status" /></td>
                                <td>
                                    @{
                                        var reporterDisplay = !string.IsNullOrWhiteSpace(bug.ReportedBy?.FullName) 
                                            ? bug.ReportedBy.FullName 
                                            : (!string.IsNullOrWhiteSpace(bug.ReportedBy?.Email) ? bug.ReportedBy.Email : "Unknown");
                                        var reporterInitial = reporterDisplay[0].ToString().ToUpper();
                                    }
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar" style="width: 24px; height: 24px; font-size: 10px;">
                                            @reporterInitial
                                        </div>
                                        <span class="text-muted" style="font-size: 13px;">@reporterDisplay</span>
                                    </div>
                                </td>
                                <td>
                                    @if (bug.AssignedTo != null)
                                    {
                                        var assigneeDisplay = !string.IsNullOrWhiteSpace(bug.AssignedTo.FullName) 
                                            ? bug.AssignedTo.FullName 
                                            : (!string.IsNullOrWhiteSpace(bug.AssignedTo.Email) ? bug.AssignedTo.Email : "Unknown");
                                        var assigneeInitial = assigneeDisplay[0].ToString().ToUpper();
                                        
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar" style="width: 24px; height: 24px; font-size: 10px; background: #FEF3C7; color: #D97706;">
                                                @assigneeInitial
                                            </div>
                                            <span class="text-muted" style="font-size: 13px;">@assigneeDisplay</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-meta fst-italic">Unassigned</span>
                                    }
                                </td>
                                <td class="pe-4 text-meta" style="font-size: 13px;">@bug.CreatedDate.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>