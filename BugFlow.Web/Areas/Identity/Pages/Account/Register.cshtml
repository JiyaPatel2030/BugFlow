@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center pt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-person-plus-fill text-main mb-3 d-block" style="font-size: 40px;"></i>
                    <h2 class="fw-bold mb-1" style="font-size: 24px; color: var(--text-main);">Create Account</h2>
                    <p class="text-meta small">Join BugFlow today</p>
                </div>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Input.FullName" class="form-label fw-medium text-meta small">Full Name</label>
                        <input asp-for="Input.FullName" class="form-control" autocomplete="name" aria-required="true" placeholder="John Doe" />
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-medium text-meta small">Email address</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-medium text-meta small">Password</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-medium text-meta small">Confirm Password</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>
                    
                    <button id="registerSubmit" type="submit" class="w-100 btn btn-primary py-2 fw-medium rounded-3">Register</button>
                </form>

                <div class="mt-4 text-center">
                    <p class="text-meta small mb-0">
                        Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-medium text-decoration-none">Sign in</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
